# ============================================
# GitHub Releases Store 后端 - 环境变量配置
# ============================================
# 复制此文件为 .env 并填入实际值
# cp .env.example .env

# ============================================
# 数据库配置 (PostgreSQL)
# ============================================
# 数据库服务器地址
POSTGRES_SERVER=localhost

# 数据库用户名
POSTGRES_USER=postgres

# 数据库密码（生产环境请使用强密码）
POSTGRES_PASSWORD=postgres

# 数据库名称
POSTGRES_DB=github_store

# 完整的数据库连接 URL（可选，会根据上面的配置自动生成）
# DATABASE_URL=postgresql://postgres:postgres@localhost/github_store

# ============================================
# Redis 配置
# ============================================
# Redis 服务器地址
REDIS_HOST=localhost

# Redis 端口
REDIS_PORT=6379

# ============================================
# Celery 配置（后台任务队列）
# ============================================
# Celery 消息代理 URL
CELERY_BROKER_URL=redis://localhost:6379/0

# Celery 结果后端 URL
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ============================================
# 安全配置
# ============================================
# JWT 密钥（生产环境必须更改！）
# 生成方法: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=yopWDFs_2CrbRXtHkZ-VCWt1CASFlPHSAu1K_1HQYDAo

# Token 过期时间（分钟），默认 7 天 = 10080 分钟
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ============================================
# GitHub API 配置
# ============================================
# GitHub Personal Access Token
# 获取方法:
# 1. 登录 GitHub
# 2. Settings -> Developer settings -> Personal access tokens -> Tokens (classic)
# 3. Generate new token，勾选 public_repo 权限
# 4. 复制生成的 token
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# Kimi AI 配置（智能助手功能，可选）
# ============================================
# Kimi API 密钥
# 获取方法: https://platform.moonshot.cn/ 注册并创建 API Key
KIMI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Kimi API 基础 URL
KIMI_API_BASE=https://api.moonshot.cn

# ============================================
# CORS 配置（跨域资源共享）
# ============================================
# 允许的前端域名列表（JSON 数组格式）
# 开发环境: Vite 默认端口是 5173
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]
